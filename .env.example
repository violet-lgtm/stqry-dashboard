# ---------------------------------------------------------------------------
# Copy to .env and fill in. Without GA_PROPERTY_ID and credentials the
# dashboard runs on generated sample data and says so on screen.
# ---------------------------------------------------------------------------

# The numeric GA4 property ID from Admin -> Property details.
# NOT the "G-XXXXXXX" measurement ID.
GA_PROPERTY_ID=123456789

# --- Credentials: pick ONE of the three options below ---

# Option 1 — the two fields that matter, as separate vars.
# Keep the surrounding quotes: the key contains literal \n sequences.
GA_CLIENT_EMAIL=stqry-dashboard@your-project.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# Option 2 — the whole service-account JSON on one line.
# Handy on hosts where you can only set env vars, not upload files.
# GA_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}

# Option 3 — a path to the downloaded key file, read by the Google library.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Optional ---

# Calendar boundaries (what counts as "today", where a month starts) are
# computed in this timezone. Set it to your GA4 property's reporting timezone,
# or the day totals will be cut in the wrong place.
GA_TIMEZONE=Europe/Amsterdam

# How many rows the "Most visited pages" panel shows.
GA_TOP_PAGES_LIMIT=10

# How long the server holds results before querying GA again. The cache is
# filled only by real requests, so an idle dashboard costs nothing. An open
# page pulls again on this cadence, but only while its tab is visible.
# Set to 0 to disable caching and query GA on every request.
CACHE_TTL_MINUTES=30

PORT=3000

# Force sample data even when credentials exist — useful for UI work.
# GA_USE_MOCK=true
